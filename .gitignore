# Local backups and generated synchronization state
/backups/
/adapters/state.json

# Python runtime artifacts
__pycache__/
*.pyc

# Environment secrets (sanitized examples may be tracked)
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.pfx
*.p12

# Local databases, logs and temporary working files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite*-wal
*.sqlite*-shm
*.log
*.tmp
/work/

# Raw diagnostic captures: kept on disk for re-checking, excluded because they
# contain host name, account name, full software path lists, TPM attestation
# and internal IP addresses. Git history is not purged by deleting a file.
原始采集/
